{
  "name": "pictures-operator",
  "version": "2.0.0",
  "description": "Module to encode, decode, and compress images in various formats directly in the browser using Web workers",
  "keywords": [
    "decode",
    "encode",
    "picture"
  ],
  "license": "MIT",
  "author": "Mark Beziaev",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src test playwright.config.mjs tsdown.config.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run package:check && npm run test:packed",
    "test": "npm run build && npm run test:unit && npm run test:browser",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "test:packed": "node test/packed-consumer/run.mjs",
    "package:check": "publint && attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@jsquash/avif": "^1.3.0",
    "@jsquash/webp": "^1.4.0",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "libheif-js": "^1.17.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "publint": "0.3.22",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0"
}
